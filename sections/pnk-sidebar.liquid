<div class="sidebar">
  <div class="sidebar-group">
    <h3 class="sidebar-title">CATEGORÍAS</h3>
    <ul class="sidebar-menu">
      <li><a href="{{ routes.all_products_collection_url }}" class="active">Todos los productos</a></li>
      <li><a href="{{ routes.collections_url }}/collares">Collares</a></li>
      <li><a href="{{ routes.collections_url }}/pulseras">Pulseras</a></li>
      <li><a href="{{ routes.collections_url }}/aretes">Aretes</a></li>
      <li><a href="{{ routes.collections_url }}/anillos">Anillos</a></li>
      <li><a href="{{ routes.collections_url }}/bolsos">Bolsos</a></li>
      <li><a href="{{ routes.collections_url }}/accesorios-cabello">Accesorios Cabello</a></li>
      <li><a href="{{ routes.collections_url }}/accesorios">Accesorios</a></li>
    </ul>
  </div>

  <div class="sidebar-group">
    <h3 class="sidebar-title">FILTRAR POR PRECIO</h3>
    <div class="price-filter">
      <div class="price-inputs-vertical">
        <div class="field">
          <span class="field-currency">$</span>
          <input type="number" placeholder="0" min="0" value="0">
        </div>
        <div class="field">
          <span class="field-currency">$</span>
          <input type="number" placeholder="20000" min="0" value="20000">
        </div>
        <button class="btn-apply-filter">
          Aplicar filtro
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .sidebar {
    padding: 24px;
    background: var(--white);
    border-radius: var(--radius-lg);
  }

  .sidebar-group {
    margin-bottom: 40px;
  }

  .sidebar-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--gray);
    letter-spacing: 0.05rem;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--gray-light);
    width: 100%;
    position: relative;
    text-transform: uppercase;
  }

  .sidebar-title::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--primary);
  }

  .sidebar-menu li {
    margin-bottom: 12px;
  }

  .sidebar-menu a {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--dark);
    display: block;
    padding: 4px 0;
    transition: var(--transition);
  }

  .sidebar-menu a:hover, .sidebar-menu a.active {
    color: var(--primary);
  }

  .price-inputs-vertical {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%; /* Ensure container is full width */
  }

  .price-inputs-vertical .field {
    display: flex;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--gray-light);
    border-radius: 8px;
    padding: 0 16px;
    height: 48px;
    transition: var(--transition);
    width: 100%; /* Take full width */
    box-sizing: border-box; /* Include padding/border in width */
  }

  .price-inputs-vertical .field:focus-within {
    border-color: var(--primary);
    outline: none;
    box-shadow: none; /* Removed shadow as requested */
  }

  .field-currency {
    color: var(--gray);
    font-weight: 700;
    font-size: 1rem;
    margin-right: 10px;
  }

  .price-inputs-vertical input {
    border: none;
    width: 100%;
    font-size: 1rem;
    font-weight: 600;
    outline: none;
    color: var(--dark);
    padding: 0;
    appearance: none;
    -moz-appearance: textfield;
    background: transparent;
    box-shadow: none !important;
  }

  .price-inputs-vertical input:focus {
    box-shadow: none !important;
    outline: none !important;
  }

  .price-inputs-vertical input::-webkit-outer-spin-button,
  .price-inputs-vertical input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .btn-apply-filter {
    background: var(--primary);
    color: var(--white);
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: var(--transition);
    text-align: center;
    width: 100%;
    margin-top: 5px;
  }

  .btn-apply-filter:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }
</style>

{% schema %}
{
  "name": "PNK Sidebar",
  "settings": [
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Menú de Categorías",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
