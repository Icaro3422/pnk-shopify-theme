{% comment %} PNK Featured Products — Amazon-style product grid {% endcomment %}

<div class="pnk-products-section">
  <div class="pnk-products-section__header">
    <div class="pnk-products-section__title-wrap">
      <h2 class="pnk-products-section__title">{{ section.settings.title }}</h2>
      <div class="pnk-products-section__title-line"></div>
    </div>
    {%- if section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="pnk-products-section__viewall">
        {{ section.settings.button_label }}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="pnk-product-grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- for product in collection.products limit: section.settings.limit -%}

      {%- liquid
        assign has_discount = false
        assign discount_pct = 0
        if product.compare_at_price > product.price
          assign has_discount = true
          assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
        endif

        assign is_new = false
        if product.tags contains 'Nuevo' or product.tags contains 'nuevo' or product.tags contains 'new'
          assign is_new = true
        endif

        assign is_popular = false
        if product.tags contains 'Popular' or product.tags contains 'popular'
          assign is_popular = true
        endif

        assign is_low_stock = false
        if product.selected_or_first_available_variant.inventory_management == 'shopify'
          if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= 5
            assign is_low_stock = true
          endif
        endif
      -%}

      <div class="pnk-pcard">

        {%- comment %} Image area {% endcomment %}
        <a href="{{ product.url }}" class="pnk-pcard__img-wrap" aria-label="{{ product.title | escape }}">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 400 }}"
              alt="{{ product.featured_media.alt | escape | default: product.title }}"
              loading="lazy"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              class="pnk-pcard__img"
            >
          {%- else -%}
            <div class="pnk-pcard__img-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'pnk-pcard__placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- comment %} Badges {% endcomment %}
          <div class="pnk-pcard__badges">
            {%- if has_discount -%}
              <span class="pnk-pcard__badge pnk-pcard__badge--discount">-{{ discount_pct }}%</span>
            {%- elsif is_new -%}
              <span class="pnk-pcard__badge pnk-pcard__badge--new">NUEVO</span>
            {%- endif -%}
            {%- if is_popular -%}
              <span class="pnk-pcard__badge pnk-pcard__badge--popular">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Popular
              </span>
            {%- endif -%}
          </div>

          {%- comment %} Soldout overlay {% endcomment %}
          {%- unless product.available -%}
            <div class="pnk-pcard__soldout-overlay">Agotado</div>
          {%- endunless -%}
        </a>

        {%- comment %} Info body {% endcomment %}
        <div class="pnk-pcard__body">

          {%- comment %} Category breadcrumb {% endcomment %}
          <div class="pnk-pcard__category">{{ product.type | default: 'Accesorio' | upcase }}</div>

          {%- comment %} Title {% endcomment %}
          <h3 class="pnk-pcard__title">
            <a href="{{ product.url }}">{{ product.title | escape }}</a>
          </h3>

          {%- comment %} Price block — Amazon style {% endcomment %}
          <div class="pnk-pcard__pricing">
            <span class="pnk-pcard__price">{{ product.price | money }}</span>
            {%- if has_discount -%}
              <span class="pnk-pcard__compare">{{ product.compare_at_price | money }}</span>
              <span class="pnk-pcard__save">Ahorra {{ product.compare_at_price | minus: product.price | money }}</span>
            {%- endif -%}
          </div>

          {%- comment %} Vendor {% endcomment %}
          {%- if product.vendor != blank -%}
            <div class="pnk-pcard__vendor">{{ product.vendor }}</div>
          {%- endif -%}

          {%- comment %} Low stock urgency {% endcomment %}
          {%- if is_low_stock -%}
            <div class="pnk-pcard__stock-warn">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              ¡Solo {{ product.selected_or_first_available_variant.inventory_quantity }} disponibles!
            </div>
          {%- endif -%}

          {%- comment %} CTA buttons {% endcomment %}
          <div class="pnk-pcard__actions">
            {%- if product.available -%}
              {%- form 'product', product, class: 'pnk-pcard__form' -%}
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="pnk-pcard__btn-add">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                  Agregar
                </button>
              {%- endform -%}
              <a href="{{ product.url }}" class="pnk-pcard__btn-view" aria-label="Ver {{ product.title | escape }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
            {%- else -%}
              <a href="{{ product.url }}" class="pnk-pcard__btn-soldout">Ver opciones</a>
            {%- endif -%}
          </div>

        </div>
      </div>

    {%- else -%}
      {%- comment %} Placeholder cards when no collection {% endcomment %}
      {%- for i in (1..section.settings.limit) -%}
        <div class="pnk-pcard pnk-pcard--skeleton">
          <div class="pnk-pcard__img-wrap">
            <div class="pnk-pcard__img-placeholder">
              {{ 'product-' | append: i | placeholder_svg_tag: 'pnk-pcard__placeholder-svg' }}
            </div>
          </div>
          <div class="pnk-pcard__body">
            <div class="pnk-pcard__category">ACCESORIO</div>
            <h3 class="pnk-pcard__title"><a href="#">Producto de Ejemplo</a></h3>
            <div class="pnk-pcard__pricing">
              <span class="pnk-pcard__price">$89.900</span>
              <span class="pnk-pcard__compare">$120.000</span>
              <span class="pnk-pcard__save">Ahorra $30.100</span>
            </div>
            <div class="pnk-pcard__actions">
              <button class="pnk-pcard__btn-add">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                Agregar
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<style>
/* ── Section header ── */
.pnk-products-section {
  padding: 0;
  margin-bottom: 64px;
}

.pnk-products-section__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 12px;
}

.pnk-products-section__title-wrap {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.pnk-products-section__title {
  font-size: 1.3rem;
  font-weight: 800;
  color: #2D2D2D;
  line-height: 1.2;
  letter-spacing: -0.3px;
}

.pnk-products-section__title-line {
  width: 40px;
  height: 3px;
  background: #E91E63;
  border-radius: 2px;
}

.pnk-products-section__viewall {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.85rem;
  font-weight: 600;
  color: #E91E63;
  white-space: nowrap;
  transition: gap 0.2s;
}

.pnk-products-section__viewall:hover {
  gap: 8px;
}

/* ── Product grid ── */
.pnk-product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

/* ── Product Card ── */
.pnk-pcard {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  transition: box-shadow 0.25s ease, transform 0.25s ease;
  display: flex;
  flex-direction: column;
}

.pnk-pcard:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,0.12);
  transform: translateY(-3px);
}

/* Image */
.pnk-pcard__img-wrap {
  position: relative;
  display: block;
  background: #fdf5f7;
  aspect-ratio: 1/1;
  overflow: hidden;
}

.pnk-pcard__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 12px;
  transition: transform 0.4s ease;
}

.pnk-pcard:hover .pnk-pcard__img {
  transform: scale(1.05);
}

.pnk-pcard__img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fdf5f7;
}

.pnk-pcard__placeholder-svg {
  width: 60%;
  height: 60%;
  opacity: 0.35;
}

/* Badges */
.pnk-pcard__badges {
  position: absolute;
  top: 8px;
  left: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  z-index: 2;
}

.pnk-pcard__badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 3px 9px;
  border-radius: 4px;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  line-height: 1.3;
}

.pnk-pcard__badge--discount {
  background: #E91E63;
  color: #fff;
}

.pnk-pcard__badge--new {
  background: #2196F3;
  color: #fff;
}

.pnk-pcard__badge--popular {
  background: #FF9800;
  color: #fff;
}

/* Soldout overlay */
.pnk-pcard__soldout-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  font-weight: 800;
  color: #757575;
  letter-spacing: 1px;
  text-transform: uppercase;
  backdrop-filter: blur(2px);
}

/* Body */
.pnk-pcard__body {
  padding: 12px 14px 14px;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 5px;
}

/* Category */
.pnk-pcard__category {
  font-size: 0.68rem;
  font-weight: 700;
  color: #bbb;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* Title */
.pnk-pcard__title {
  font-size: 0.9rem;
  font-weight: 600;
  color: #2D2D2D;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}

.pnk-pcard__title a {
  color: inherit;
  transition: color 0.2s;
}

.pnk-pcard__title a:hover {
  color: #E91E63;
}

/* Pricing — Amazon style */
.pnk-pcard__pricing {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 5px;
  margin-top: 2px;
}

.pnk-pcard__price {
  font-size: 1.15rem;
  font-weight: 800;
  color: #E91E63;
  letter-spacing: -0.5px;
}

.pnk-pcard__compare {
  font-size: 0.8rem;
  color: #bbb;
  text-decoration: line-through;
  font-weight: 500;
}

.pnk-pcard__save {
  font-size: 0.72rem;
  font-weight: 700;
  color: #4CAF50;
  background: #e8f5e9;
  padding: 2px 7px;
  border-radius: 4px;
}

/* Vendor */
.pnk-pcard__vendor {
  font-size: 0.72rem;
  color: #aaa;
  font-weight: 500;
}

/* Low stock warning */
.pnk-pcard__stock-warn {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.72rem;
  font-weight: 600;
  color: #FF9800;
  margin-top: 2px;
}

/* Actions */
.pnk-pcard__actions {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: auto;
  padding-top: 10px;
}

.pnk-pcard__form {
  flex: 1;
}

.pnk-pcard__btn-add {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 9px 14px;
  background: #E91E63;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.2px;
}

.pnk-pcard__btn-add:hover {
  background: #C2185B;
  box-shadow: 0 3px 12px rgba(233,30,99,0.35);
}

.pnk-pcard__btn-view {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  border: 1.5px solid #E91E63;
  color: #E91E63;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.pnk-pcard__btn-view:hover {
  background: #E91E63;
  color: #fff;
}

.pnk-pcard__btn-soldout {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 9px 14px;
  border: 1.5px solid #ddd;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  color: #757575;
  transition: all 0.2s;
}

.pnk-pcard__btn-soldout:hover {
  border-color: #999;
  color: #2D2D2D;
}

/* ── RESPONSIVE ── */
@media screen and (max-width: 1024px) {
  .pnk-product-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
}

@media screen and (max-width: 768px) {
  .pnk-products-section {
    margin-bottom: 40px;
  }

  .pnk-product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .pnk-products-section__title {
    font-size: 1.1rem;
  }

  .pnk-pcard__title {
    font-size: 0.82rem;
  }

  .pnk-pcard__price {
    font-size: 1rem;
  }

  .pnk-pcard__body {
    padding: 10px 10px 12px;
    gap: 4px;
  }

  .pnk-pcard__save {
    display: none; /* save space on very small */
  }

  .pnk-pcard__btn-add {
    font-size: 0.78rem;
    padding: 8px 10px;
    gap: 5px;
  }

  .pnk-pcard__btn-view {
    width: 34px;
    height: 34px;
  }
}

@media screen and (max-width: 380px) {
  .pnk-product-grid {
    gap: 10px;
  }

  .pnk-pcard__img-wrap {
    aspect-ratio: 1/1;
  }
}
</style>

{% schema %}
{
  "name": "PNK Featured Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de sección",
      "default": "Productos Destacados"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección a mostrar"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Número de productos",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar etiquetas (Nuevo, Oferta)",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del enlace 'Ver todos'",
      "default": "Ver todos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace 'Ver todos'"
    }
  ],
  "presets": [
    {
      "name": "PNK Featured Products"
    }
  ]
}
{% endschema %}
