<div class="pnk-section">
  <div class="section-header" style="justify-content: space-between; align-items: baseline; border-bottom: none; margin-bottom: 10px;">
    <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--dark);">{{ section.settings.title }}</h2>
    {%- if section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" style="font-size: 0.9rem; color: var(--primary); font-weight: 600;">{{ section.settings.button_label }} <i class="fas fa-arrow-right" style="font-size: 0.8rem;"></i></a>
    {%- endif -%}
  </div>

  <div class="products-grid" style="gap: 20px;">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- for product in collection.products limit: section.settings.limit -%}
      <div class="product-card" style="border: none; box-shadow: none; background: transparent;">
        <div class="product-card-img" style="border-radius: var(--radius-lg); background: var(--primary-bg); aspect-ratio: 1/1;">
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 400 }}" 
              alt="{{ product.title | escape }}" 
              loading="lazy"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              style="object-fit: contain; padding: 20px;">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-img' }}
          {%- endif -%}
          {%- if section.settings.show_badge and product.tags contains 'Nuevo' -%}
            <span class="product-card-badge" style="background:var(--primary); left: 10px; top: 10px; font-size: 0.7rem; border-radius: 4px;">Nuevo</span>
          {%- elsif section.settings.show_badge and product.compare_at_price > product.price -%}
            <span class="product-card-badge" style="background:var(--secondary); left: 10px; top: 10px; font-size: 0.7rem; border-radius: 4px;">Oferta</span>
          {%- endif -%}
        </div>
        <div class="product-card-body" style="padding: 15px 0 0 0;">
          <div class="product-card-category" style="color: var(--gray); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">{{ product.type | default: 'Accesorio' }}</div>
          <h3 class="product-card-name" style="font-size: 1rem; margin: 4px 0;"><a href="{{ product.url }}">{{ product.title }}</a></h3>
          <div class="product-card-price" style="font-weight: 700; color: var(--primary); font-size: 1.1rem; margin-bottom: 15px;">
            {{ product.price | money }}
            {%- if product.compare_at_price > product.price -%}
              <span class="old-price" style="font-weight: 400; color: var(--gray); font-size: 0.9rem;">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
          <div class="product-card-actions">
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="btn-add-to-cart">
                <i class="fas fa-shopping-cart"></i> Agregar
              </button>
            {%- endform -%}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <div class="product-card" style="border: none; box-shadow: none; background: transparent;">
          <div class="product-card-img" style="border-radius: var(--radius-lg); background: var(--primary-bg); aspect-ratio: 1/1;">
            {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-img' }}
          </div>
          <div class="product-card-body" style="padding: 15px 0 0 0;">
            <div class="product-card-category" style="color: var(--gray); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Collares</div>
            <h3 class="product-card-name" style="font-size: 1rem; margin: 4px 0;">Producto de Ejemplo</h3>
            <div class="product-card-price" style="font-weight: 700; color: var(--primary); font-size: 1.1rem; margin-bottom: 15px;">$89.900</div>
            <div class="product-card-actions">
              <button class="btn-add-to-cart">
                <i class="fas fa-shopping-cart"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "PNK Featured Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de sección",
      "default": "Productos Destacados"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección a mostrar"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Número de productos",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar etiquetas (Nuevo, Oferta)",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del enlace 'Ver todos'",
      "default": "Ver todos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace 'Ver todos'"
    }
  ],
  "presets": [
    {
      "name": "PNK Featured Products"
    }
  ]
}
{% endschema %}
