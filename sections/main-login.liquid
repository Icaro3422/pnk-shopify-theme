{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="auth-wrapper">
  <div class="customer login auth-card">
    
    <div class="auth-logo">
      <img src="{{ 'pnk-logo-v2.png' | asset_url }}" alt="PNK" style="width:100%;max-width:140px;height:auto;margin:0 auto;display:block;">
    </div>

    <div id="recover-form" style="display:none;" class="auth-box">
      <h3>{{ 'customer.recover_password.title' | t }}</h3>
      <p style="text-align: center; color: var(--gray); font-size: 0.9rem; margin-bottom: 24px;">
        {{ 'customer.recover_password.subtext' | t }}
      </p>

      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
        
        <div class="form-group">
          <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input type="email" value="" name="email" id="RecoverEmail" class="form-control"
            autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="tu@email.com"
            {% if form.errors %}aria-invalid="true" aria-describedby="RecoverEmail-email-error" autofocus{% endif %}>
        </div>
        
        {%- if form.errors -%}
          <div id="RecoverEmail-email-error" style="color:var(--danger);font-size:0.85rem;margin-top:-10px;margin-bottom:15px;">
            {{ form.errors.messages.form }}
          </div>
        {%- endif -%}

        <button type="submit" class="btn btn-primary btn-block btn-lg">
          {{ 'customer.login_page.submit' | t }}
        </button>

        <div style="text-align:center; margin-top:20px;">
          <a href="#login" onclick="document.getElementById('recover-form').style.display='none'; document.getElementById('login-form').style.display='block'; return false;" style="color:var(--primary);font-size:0.9rem;font-weight:500;">
            {{ 'customer.login_page.cancel' | t }}
          </a>
        </div>
      {%- endform -%}
    </div>

    <div id="login-form" class="auth-box">
      <h3>Iniciar Sesión</h3>
      
      {%- if recover_success == true -%}
        <div style="color:var(--success);background:#E8F5E9;padding:12px;border-radius:8px;font-size:0.9rem;margin-bottom:20px;text-align:center;">
          {{ 'customer.recover_password.success' | t }}
        </div>
      {%- endif -%}
      
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div tabindex="-1" autofocus style="color:var(--danger);background:#FFEBEE;padding:12px;border-radius:8px;font-size:0.9rem;margin-bottom:20px;text-align:center;">
            {{ 'templates.contact.form.error_heading' | t }}
          </div>
        {%- endif -%}

        <div class="form-group">
          <label for="CustomerEmail">Correo electrónico</label>
          <input type="email" name="customer[email]" id="CustomerEmail" class="form-control" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="tu@email.com">
        </div>

        {%- if form.password_needed -%}
          <div class="form-group">
            <label for="CustomerPassword">Contraseña</label>
            <input type="password" value="" name="customer[password]" id="CustomerPassword" class="form-control" autocomplete="current-password" placeholder="Tu contraseña">
          </div>

          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;font-size:0.85rem;">
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
              <input type="checkbox" name="remember" checked style="accent-color:var(--primary);"> Recordarme
            </label>
            <a href="#recover" onclick="document.getElementById('login-form').style.display='none'; document.getElementById('recover-form').style.display='block'; return false;" style="color:var(--primary);font-weight:500;">
              ¿Olvidaste tu contraseña?
            </a>
          </div>
        {%- endif -%}

        <button type="submit" class="btn btn-primary btn-block btn-lg">
          Iniciar Sesión
        </button>

        <div style="text-align:center;margin:24px 0;color:var(--gray);font-size:0.85rem;position:relative;">
          <span style="background:var(--white);padding:0 10px;position:relative;z-index:1;">— o continúa con —</span>
        </div>

        <div style="display:flex;gap:12px;margin-bottom:24px;">
          <button type="button" class="btn btn-outline btn-block" style="font-size:0.85rem;">
            <i class="fab fa-google"></i> Google
          </button>
          <button type="button" class="btn btn-outline btn-block" style="font-size:0.85rem;">
            <i class="fab fa-facebook-f"></i> Facebook
          </button>
        </div>

        <div class="auth-footer" style="text-align:center;font-size:0.9rem;">
          ¿No tienes cuenta? <a href="{{ routes.account_register_url }}" style="color:var(--primary);font-weight:600;">Regístrate aquí</a>
        </div>
      {%- endform -%}
    </div>
    
  </div>
</div>

<style>
/* ── Mockup Styles applied to Login Scope ── */
.auth-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 150px);
  padding: 40px 20px;
  background-color: var(--gray-bg, #F9F9F9);
}

.auth-card {
  background: var(--white, #fff);
  width: 100%;
  max-width: 440px;
  border-radius: var(--radius-lg, 16px);
  padding: 40px 32px;
  box-shadow: var(--shadow, 0 4px 16px rgba(0,0,0,0.08));
}

.auth-logo {
  text-align: center;
  margin-bottom: 32px;
}

.auth-logo h2 {
  display: none; /* using image instead */
}

.auth-box h3 {
  font-size: 1.5rem;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24px;
  color: var(--dark, #2D2D2D);
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 0.85rem;
  font-weight: 500;
  margin-bottom: 8px;
  color: var(--dark, #2D2D2D);
}

.form-control {
  width: 100%;
  padding: 12px 14px;
  border: 1.5px solid var(--gray-light, #E0E0E0);
  border-radius: var(--radius, 8px);
  outline: none;
  transition: all 0.2s;
  font-size: 0.95rem;
}

.form-control:focus {
  border-color: var(--primary, #E91E63);
  box-shadow: 0 0 0 4px rgba(233,30,99,0.1);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: var(--radius, 8px);
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.25s;
}

.btn-lg {
  padding: 14px 32px;
  font-size: 1rem;
}

.btn-block {
  width: 100%;
}

.btn-primary {
  background: var(--primary, #E91E63);
  color: #fff;
}

.btn-primary:hover {
  background: var(--primary-dark, #C2185B);
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent;
  border: 2px solid var(--gray-light, #E0E0E0);
  color: var(--dark, #2D2D2D);
}

.btn-outline:hover {
  border-color: var(--primary, #E91E63);
  color: var(--primary, #E91E63);
}

@media screen and (max-width: 480px) {
  .auth-card {
    padding: 32px 24px;
  }
}
</style>


{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
