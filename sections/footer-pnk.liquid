<footer class="footer">
  <div class="footer-grid">
    <!-- Columna 1: PNK -->
    <div class="footer-col footer-col-text">
      <div style="color: #FFFFFF; margin-bottom: 20px;">
        <img src="{{ 'pnk-logo-v2.png' | asset_url }}" alt="PNK" style="height: 60px; width: auto;" width="4992" height="2675">
      </div>
      <div class="rte">
        <p>Accesorios diseñados con amor para mujeres que no tienen miedo de brillar.</p>
      </div>
      {%- if section.settings.show_social -%}
        <div class="footer-social">
          <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="#" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
          <a href="#" aria-label="Pinterest"><i class="fab fa-pinterest-p"></i></a>
        </div>
      {%- endif -%}
    </div>

    <!-- Columna 2: Información -->
    <div class="footer-col">
      <h4>Información</h4>
      <ul>
        <li><a href="/pages/sobre-nosotros">Sobre nosotros</a></li>
        <li><a href="/pages/contacto">Contacto</a></li>
        <li><a href="/blogs/news">Blog</a></li>
      </ul>
    </div>

    <!-- Columna 3: Ayuda -->
    <div class="footer-col">
      <h4>Ayuda</h4>
      <ul>
        <li><a href="/pages/preguntas-frecuentes">Preguntas frecuentes</a></li>
        <li><a href="/pages/politicas-de-envio">Políticas de envío</a></li>
        <li><a href="/pages/devoluciones">Devoluciones</a></li>
        <li><a href="/pages/guia-de-tallas">Guía de tallas</a></li>
      </ul>
    </div>

    <!-- Columna 4: Legal -->
    <div class="footer-col">
      <h4>Legal</h4>
      <ul>
        <li><a href="/pages/terminos-y-condiciones">Términos y condiciones</a></li>
        <li><a href="/pages/politica-de-privacidad">Política de privacidad</a></li>
        <li><a href="/pages/cookies">Cookies</a></li>
      </ul>
    </div>
  </div>
  
  {%- if section.settings.newsletter_enable -%}
    <div class="footer-newsletter">
      <div class="container text-center">
        {%- if section.settings.newsletter_heading != blank -%}
          <h3>{{ section.settings.newsletter_heading }}</h3>
        {%- endif -%}
        {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="ContactFooter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="ContactFooter-success"
                {% endif %}
                placeholder="Email"
                required
              >
              <button type="submit" class="newsletter-form__button button" name="commit" id="Subscribe">
                Suscribirse
              </button>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="footer-bottom">
    <div class="container">
      <p>© {{ 'now' | date: "%Y" }} {{ shop.name }}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer PNK",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Mostrar suscripción al boletín"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Suscríbete a nuestras noticias",
      "label": "Título del boletín"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Mostrar iconos de redes sociales"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Mostrar iconos de pago"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "Mostrar selector de país/región"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "Mostrar selector de idioma"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": false,
      "label": "Mostrar políticas"
    },
    {
      "type": "header",
      "content": "Margen y Relleno"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menú",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Enlaces rápidos"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}
