<div class="pnk-section" style="background: var(--primary-bg); padding: 48px; border-radius: var(--radius-lg); margin-top: 32px;">
  <div class="section-header" style="text-align: center; margin-bottom: 32px;">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
    {%- for block in section.blocks -%}
      <div class="testimonial-card" style="background: var(--white); padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow);">
        <div style="color: var(--warning); margin-bottom: 12px;">
          {%- for i in (1..5) -%}
            <i class="fas fa-star"></i>
          {%- endfor -%}
        </div>
        <p style="font-style: italic; margin-bottom: 16px; color: var(--gray);">"{{ block.settings.text }}"</p>
        <div style="font-weight: 600; font-size: 0.9rem;">- {{ block.settings.author }}</div>
      </div>
    {%- else -%}
      <p>Añade testimonios aquí.</p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "PNK Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Lo que dicen nuestras clientas"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "¡Me encantaron los accesorios! La calidad es increíble y el envío fue rapidísimo. Definitivamente volveré a comprar."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autor",
          "default": "María González."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PNK Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
