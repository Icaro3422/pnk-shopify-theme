{%- liquid
  assign bg1 = section.settings.bg_color_1 | default: '#E91E63'
  assign bg2 = section.settings.bg_color_2 | default: '#FF6F91'
-%}

<div class="pnk-hero" style="background: linear-gradient(135deg, {{ bg1 }} 0%, {{ bg2 }} 100%);">
  <div class="pnk-hero__content">
    <div class="pnk-hero__badge">Nueva Colección 2026</div>
    <h1 class="pnk-hero__title">{{ section.settings.title }}</h1>
    <p class="pnk-hero__subtitle">{{ section.settings.subtitle }}</p>
    <div class="pnk-hero__actions">
      <a href="{{ section.settings.button_link }}" class="pnk-hero__btn-primary">
        {{ section.settings.button_label }}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="{{ routes.collections_url }}" class="pnk-hero__btn-secondary">Ver categorías</a>
    </div>
    <div class="pnk-hero__trust">
      <span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        +500 clientes felices
      </span>
      <span>Envío gratis desde $50.000</span>
    </div>
  </div>
  <div class="pnk-hero__deco" aria-hidden="true">
    <span class="pnk-hero__deco-heart">♥</span>
  </div>
</div>

<style>
.pnk-hero {
  position: relative;
  overflow: hidden;
  padding: 64px 48px;
  min-height: 320px;
  display: flex;
  align-items: center;
  border-radius: 20px;
  margin-bottom: 64px; /* Standard section spacing */
}

.pnk-hero__content {
  position: relative;
  z-index: 2;
  max-width: 540px;
  color: #fff;
}

.pnk-hero__badge {
  display: inline-block;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.35);
  border-radius: 50px;
  padding: 5px 16px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 16px;
  color: rgba(255,255,255,0.95);
}

.pnk-hero__title {
  font-size: 2.6rem;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -0.5px;
  margin-bottom: 14px;
}

.pnk-hero__subtitle {
  font-size: 1rem;
  opacity: 0.9;
  line-height: 1.6;
  margin-bottom: 28px;
  max-width: 420px;
}

.pnk-hero__actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 28px;
}

.pnk-hero__btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  color: #E91E63;
  padding: 12px 28px;
  border-radius: 50px;
  font-size: 0.95rem;
  font-weight: 800;
  transition: all 0.25s;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  white-space: nowrap;
}

.pnk-hero__btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.2);
}

.pnk-hero__btn-secondary {
  display: inline-flex;
  align-items: center;
  padding: 12px 24px;
  border-radius: 50px;
  border: 2px solid rgba(255,255,255,0.6);
  color: #fff;
  font-size: 0.9rem;
  font-weight: 700;
  transition: all 0.25s;
  white-space: nowrap;
}

.pnk-hero__btn-secondary:hover {
  background: rgba(255,255,255,0.15);
  border-color: #fff;
}

.pnk-hero__trust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  font-size: 0.8rem;
  opacity: 0.85;
}

.pnk-hero__trust span {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Decorative heart */
.pnk-hero__deco {
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  pointer-events: none;
}

.pnk-hero__deco-heart {
  font-size: 16rem;
  opacity: 0.1;
  color: #fff;
  line-height: 1;
  display: block;
}

/* ── RESPONSIVE ── */
@media screen and (max-width: 768px) {
  .pnk-hero {
    padding: 44px 24px 48px;
    min-height: 260px;
    border-radius: 16px;
    margin-bottom: 40px;
  }

  .pnk-hero__title {
    font-size: 1.8rem;
  }

  .pnk-hero__subtitle {
    font-size: 0.9rem;
    margin-bottom: 20px;
  }

  .pnk-hero__actions {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 20px;
  }

  .pnk-hero__btn-primary,
  .pnk-hero__btn-secondary {
    width: 100%;
    justify-content: center;
    padding: 13px 20px;
  }

  .pnk-hero__deco-heart {
    font-size: 10rem;
    opacity: 0.08;
  }

  .pnk-hero__trust {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
}

@media screen and (max-width: 480px) {
  .pnk-hero__title {
    font-size: 1.55rem;
  }
}
</style>

{% schema %}
{
  "name": "PNK Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Accesorios con Actitud ♥"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Descubre nuestra nueva colección de accesorios diseñados para resaltar tu estilo único."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etiqueta del botón",
      "default": "Ver Colección"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Color de fondo 1",
      "default": "#E91E63"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Color de fondo 2",
      "default": "#FF6F91"
    }
  ],
  "presets": [
    {
      "name": "PNK Hero Banner"
    }
  ]
}
{% endschema %}
