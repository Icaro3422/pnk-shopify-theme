          "settings": {
            "custom_liquid": "{% if product.has_only_default_variant == false %}\n  <div class=\"pnk-prosa-selector\" style=\"margin:18px 0;\">\n    <p style=\"font-weight:700; margin-bottom:10px;\">\n      Elige tu tipo de Prosa ✨\n    </p>\n\n    {% for variant in product.variants %}\n      <button\n        type=\"button\"\n        class=\"pnk-prosa-btn{% if variant.id == product.selected_or_first_available_variant.id %} pnk-active{% endif %}\"\n        data-title=\"{{ variant.title | escape }}\"\n      >\n        {{ variant.title }}\n      </button>\n    {% endfor %}\n  </div>\n\n  <style>\n    .pnk-prosa-btn {\n      display:block;\n      width:100%;\n      margin-bottom:8px;\n      padding:12px;\n      border:1px solid #ff2f73;\n      border-radius:20px;\n      background:#fff;\n      color:#222;\n      cursor:pointer;\n    }\n\n    .pnk-prosa-btn.pnk-active {\n      background:#ff2f73;\n      color:#fff;\n      font-weight:700;\n    }\n  </style>\n\n  <script>\n    document.addEventListener('click', function(e) {\n      const btn = e.target.closest('.pnk-prosa-btn');\n      if (!btn) return;\n\n      const title = btn.dataset.title.trim().toLowerCase();\n\n      const radios = document.querySelectorAll(\n        'variant-selects input[type=\"radio\"], variant-radios input[type=\"radio\"], input[name^=\"options\"]'\n      );\n\n      radios.forEach(function(radio) {\n        if ((radio.value || '').trim().toLowerCase() === title) {\n          radio.click();\n          radio.dispatchEvent(new Event('input', { bubbles: true }));\n          radio.dispatchEvent(new Event('change', { bubbles: true }));\n        }\n      });\n\n      document.querySelectorAll('.pnk-prosa-btn').forEach(function(b) {\n        b.classList.remove('pnk-active');\n      });\n\n      btn.classList.add('pnk-active');\n    });\n  </script>\n{% endif %}"
