          "settings": {
            "custom_liquid": "{% if product.has_only_default_variant == false %}\n  <div class=\"pnk-prosa-selector\" style=\"margin: 18px 0;\">\n    <p style=\"font-weight:700; margin-bottom:10px;\">\n      Elige tu tipo de Prosa ✨\n    </p>\n\n    {% for variant in product.variants %}\n      <button\n        type=\"button\"\n        class=\"pnk-prosa-btn{% if variant.id == product.selected_or_first_available_variant.id %} pnk-active{% endif %}\"\n        data-variant-id=\"{{ variant.id }}\"\n        data-variant-title=\"{{ variant.title | escape }}\"\n      >\n        {{ variant.title }}\n      </button>\n    {% endfor %}\n  </div>\n\n  <style>\n    .pnk-prosa-btn {\n      display:block;\n      width:100%;\n      margin-bottom:8px;\n      padding:12px;\n      border:1px solid #ff2f73;\n      border-radius:20px;\n      background:#fff;\n      color:#222;\n      cursor:pointer;\n    }\n\n    .pnk-prosa-btn.pnk-active {\n      background:#ff2f73;\n      color:#fff;\n      font-weight:700;\n    }\n  </style>\n\n  <script>\n    (function() {\n      function normalizeText(text) {\n        return (text || '').trim().toLowerCase();\n      }\n\n      function activatePnkButtonByTitle(title) {\n        var normalizedTitle = normalizeText(title);\n\n        document.querySelectorAll('.pnk-prosa-btn').forEach(function(btn) {\n          var buttonTitle = normalizeText(\n            btn.getAttribute('data-variant-title')\n          );\n\n          btn.classList.toggle(\n            'pnk-active',\n            buttonTitle === normalizedTitle\n          );\n        });\n      }\n\n      document.addEventListener('click', function(event) {\n        var button = event.target.closest('.pnk-prosa-btn');\n\n        if (button) {\n          var title = button.getAttribute('data-variant-title');\n\n          var realVariantButtons = document.querySelectorAll(\n            'input[type=\"radio\"][name^=\"options\"], input[type=\"radio\"]'\n          );\n\n          realVariantButtons.forEach(function(realButton) {\n            if (\n              normalizeText(realButton.value) === normalizeText(title)\n            ) {\n              realButton.click();\n            }\n          });\n\n          activatePnkButtonByTitle(title);\n          return;\n        }\n\n        var realButton = event.target.closest(\n          'input[type=\"radio\"][name^=\"options\"], input[type=\"radio\"]'\n        );\n\n        if (realButton && realButton.value) {\n          setTimeout(function() {\n            activatePnkButtonByTitle(realButton.value);\n          }, 100);\n        }\n      });\n\n      document.addEventListener('change', function(event) {\n        var target = event.target;\n\n        if (\n          target.matches('input[type=\"radio\"][name^=\"options\"]') ||\n          target.matches('input[type=\"radio\"]')\n        ) {\n          setTimeout(function() {\n            activatePnkButtonByTitle(target.value);\n          }, 100);\n        }\n      });\n    })();\n  </script>\n{% endif %}"
