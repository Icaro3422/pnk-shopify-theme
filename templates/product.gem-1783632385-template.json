    "custom_liquid_UUQ4iA": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"pnk-kit\">\n  <p class=\"pnk-kit-title\">Elige 3 variedades ✨<\/p>\n  <p class=\"pnk-kit-count\">Seleccionadas: <span id=\"pnk-count\">0<\/span>\/3<\/p>\n\n  <div class=\"pnk-kit-options\">\n    {% for variant in product.variants %}\n      <button\n        type=\"button\"\n        class=\"pnk-kit-btn\"\n        data-id=\"{{ variant.id }}\"\n      >\n        {{ variant.title }}\n      <\/button>\n    {% endfor %}\n  <\/div>\n\n  <button type=\"button\" id=\"pnk-kit-cart\" disabled>\n    Elige 3 variedades\n  <\/button>\n<\/div>\n\n<style>\n.pnk-kit {\n  margin: 20px 0;\n}\n\n.pnk-kit-title {\n  font-weight: 700;\n  font-size: 18px;\n  margin-bottom: 5px;\n}\n\n.pnk-kit-count {\n  font-size: 14px;\n  margin-bottom: 12px;\n}\n\n.pnk-kit-btn {\n  width: 100%;\n  padding: 13px;\n  margin-bottom: 8px;\n  border: 1px solid #ff2f73;\n  border-radius: 22px;\n  background: white;\n  cursor: pointer;\n}\n\n.pnk-kit-btn.selected {\n  background: #ff2f73;\n  color: white;\n  font-weight: 700;\n}\n\n#pnk-kit-cart {\n  width: 100%;\n  padding: 15px;\n  margin-top: 12px;\n  border: 0;\n  border-radius: 22px;\n  background: #ff2f73;\n  color: white;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n#pnk-kit-cart:disabled {\n  opacity: .45;\n  cursor: not-allowed;\n}\n<\/style>\n\n<script>\n(function () {\n  const buttons = document.querySelectorAll('.pnk-kit-btn');\n  const count = document.getElementById('pnk-count');\n  const cart = document.getElementById('pnk-kit-cart');\n\n  let selected = [];\n\n  buttons.forEach(button => {\n    button.addEventListener('click', function () {\n      const id = this.dataset.id;\n\n      if (selected.includes(id)) {\n        selected = selected.filter(item => item !== id);\n        this.classList.remove('selected');\n      } else {\n        if (selected.length >= 3) return;\n\n        selected.push(id);\n        this.classList.add('selected');\n      }\n\n      count.textContent = selected.length;\n\n      if (selected.length === 3) {\n        cart.disabled = false;\n        cart.textContent = 'Agregar kit al carrito';\n      } else {\n        cart.disabled = true;\n        cart.textContent = 'Elige ' + (3 - selected.length) + ' variedades más';\n      }\n    });\n  });\n\n  cart.addEventListener('click', async function () {\n    if (selected.length !== 3) return;\n\n    cart.disabled = true;\n    cart.textContent = 'Agregando...';\n\n    const items = selected.map(id => ({\n      id: Number(id),\n      quantity: 1\n    }));\n\n    await fetch('\/cart\/add.js', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application\/json'\n      },\n      body: JSON.stringify({ items })\n    });\n\n    window.location.href = '\/cart';\n  });\n})();\n<\/script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
